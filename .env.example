# ─── Core ─────────────────────────────────────────────────────────────
# Neon: pooled connection (host contains "-pooler") with pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/duoonex?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon: direct (non-pooled) connection, used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/duoonex?sslmode=require"
# Local dev alternative (npm run dev:db):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

# openssl rand -base64 48
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for /api/cron (GitHub Actions / Vercel Cron)
CRON_SECRET=

# ─── Email (Resend preferred, SMTP fallback) ──────────────────────────
EMAIL_FROM="Nexora <support@yourdomain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Inbound email-to-ticket webhook secret (x-inbound-secret header)
INBOUND_EMAIL_SECRET=
# Recipient of /contact demo requests (form hidden when unset)
SALES_EMAIL=

# ─── Object storage (Neon / S3-compatible) ───────────────────
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto"
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Neon-compatible aliases (use either AWS_* or S3_*, not conflicting values)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=media

# Optional managed Neon Auth sign-in (verified Neon accounts)
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=

# ─── Optional SSO ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ─── Optional billing (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=

# ─── Optional observability ───────────────────────────────────────────
SENTRY_DSN=
